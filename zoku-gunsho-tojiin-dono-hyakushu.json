  },
  {
   "seq": "20",
   "text": "行春の名残をしたふ涙にや猶おほろなる有明の月",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "昨日こそ春は暮しにぬきかへて花の香遠き夏衣かな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "夕やみのころとしらすは月影にまかへてみまし庭の卯花",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "神山の杜の下草路ならし待日かさなる郭鳥かな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "夢路にはさたかにもなき時鳥今一声を寝覚にそ待",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "あやめ草引てあまたに沼水の濁て暫しすむ程もなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "ふらぬまも雲のゆきゝはとたへねは月影うとき五月雨のころ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "軒ちかき竹の葉分に涼きは風にもりくる窓の月影",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "おく山の岩かきぬまは水草ゐて蛍飛かふ影も移らす",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "この里はふらぬも涼し風すきてとをちにはるゝ夕立の空",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "難波人みそさすらしも立苅の簾の一よに秋を隔てゝ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "このねぬる朝気の風のかはるより萩の葉そよき秋やきぬらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "暮ぬより待渉るらし七夕の稀に逢夜の鵲のはし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "天の川渡の川となりにけり棚機つめの今朝の列に",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "影やとす月のためにて秋のよは徒ならす露も置らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "をく露をかことに靡く女郎死咲もあたなる花と見えつゝ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "秋風に野をなつかしみとまれとや招く夕の花薄かな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "夜寒なる暁露にたかまとの野への真萩そ下は色つく",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "ふけて猶夜寒やまさる蚕寝覚の閨に声よはるなり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "秋風に浮立雪はままへとも長閑にわたる雁の一行",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "夕つくよ入ぬる後の小倉山鹿の音のみそかくれさり鳬",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "霧はらふ比良の山風更る夜にさゝ波はれて出る月影",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "まきもくの檜原の山の夜半の月木間の外に見る影もなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "木間もる心尽しの影もなし山端遠くふくる夜の月",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "をのつから人はまとろむ不破の関軒の板間を月そもりける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "なにことも月見る程は忘むに秋をうれへと誰かいひけん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "更るまて暫しとたえて暁の寝覚よりまた擣衣かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "うつろはゝそれとやみむ吹上の浪にまかへる白菊の花",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "今朝は猶色こそまきれ立田山夜半の時雨の深日もみちは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "ひとつ色に染なすよりも薄くこく交るもみちそ錦なりける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "暮て行秋の道とや成ぬらむうら枯わたる草の原かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "しからきの外山の雲の打時雨今日や里人冬をしるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "日かけさす都この方ハ空晴て時雨に残る峰の浮雲",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "散積る木の葉まて尚通ひきて庭にも風の音は絶せず",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "晴に乗る雪けの雪の跡に又かはりて月の影そこほれる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "一壺霜を払ひかねてや青葉なる鴨の羽かひも色かはるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "閉る夜のせゝの汐風吹なへに絵島をかけて千鳥鳴なり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "庭まては積るともみすたゝひとへ松の上のみ降るしら雪",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "をとつるゝ松の嵐も絶果て雪に友なき山の奥かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "箸鷹はみな白ふにそ成にける雪かき暮す今朝のさかりは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "誰もみな老と成へき年波の行徳もしらす何ゑくらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "自ら人も教へぬ思ひにて迷ひ初るや恋路なるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "猶も又つらさのそはゝいかならむ今たにもなき心迷ひに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "をさふれは中々色に出ぬへし人まにいかて涙ゆるさん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "せく袖の涙をそふる月影を等閑にこそ人は見るらめ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "わたつうみの深く思ふもかひなくて人をみるめのかたき中哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "うき中はあはての浦にやく塩のからき思そわするまゝなき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "憂ことや習はさるらん我思ふ心をいかて人にかへまし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "連もなきひとの心に習ひてや我さへこりす猶慕ふらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "其船川玉ちる波のくたけつゝ思ふこゝろを食とはみよ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "思ひわひねられぬまゝに夢にさへ通ひ絶ぬる人の西影",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "たか方のまことになしてかはるらんうき我からにさはる契は",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "人目こそ猶くるしけれゑた帯の解ても下にむすほゝれつゝ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "鶏のさ鳴ともいまた夜ふかきになと憂人の急く成らん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
