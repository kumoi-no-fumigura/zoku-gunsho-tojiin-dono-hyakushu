   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "いとゝ猶袖そしほるゝ白露の松き別れ行今朝の道芝",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "偽りの誠になるはなき世にてうき方にこそかはり安けれ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "逢坂や越て苦しき道ならむ又立かへる元のつらさに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "今更に人も迷はし蓬生のもとのこゝろに又もかよはゝ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "ことの葉もかよはすなれは偽りと恨みしころを又しのふかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "心をはしほるゝ袖の包にしれうきは涙の外ならはこそ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395149",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "応二十首",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "かきくらす涙ならては憂人に恨るふしの言の葉もなし",
   "kana": "",
   "speaker": "",
   "page": 7,
